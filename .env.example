RELAY_HOST=0.0.0.0
RELAY_PORT=18802

# 請改成自己的長隨機字串，不能使用預設值。
RELAY_API_KEY=請替換成長隨機字串

DEFAULT_MODEL=gemini-3.8-flash
COOKIES_DIR=./cookies

# Relay 預設會在同一個容器內啟動 Proof Server。
AUTO_START_PROOF=1
PROOF_HOST=127.0.0.1
PROOF_PORT=18801

# Proof Server 的 24 小時 mint 紀錄放在綁定的 data 目錄。
MINT_LEDGER_FILE=/app/3-waa-proof-server/data/mint-ledger.log

